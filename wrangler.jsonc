{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clientflare",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    // Optional. Leave empty and the app uses the URL it is served from (workers.dev or a custom domain).
    // Set it only if you serve the app from more than one hostname.
    "APP_URL": "",
    "EMAIL_FROM": "Clientflare <noreply@example.com>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clientflare-db",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "clientflare-files" }]
}
