{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clientflare",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    // Only used once RESEND_API_KEY is set. Must be a sender on a domain Resend verifies.
    "EMAIL_FROM": "Clientflare <noreply@example.com>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clientflare-db",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "clientflare-files" }]
}
